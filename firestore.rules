rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 立場は3つ。オーナー（admins の role が owner）、移民管理者（同 manager）、登録者（ログイン不要）
    // 移民管理者かオーナーか（移民情報をすべて見られる人）
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // オーナーか
    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // 入力形式（設計書 9.1）
    // 名前：1文字以上。画面側で20文字までに制限する。ルール側は、文字の数え方の差を見込んで40まで
    function validName(v) { return v is string && v.size() >= 1 && v.size() <= 40; }
    function validGameId(v)   { return v is string && v.matches('^[0-9]{9}$'); }
    function validCountry(v)  { return v is string && v.matches('^[0-9]{4}$'); }
    // 同盟は任意：空文字、または大文字アルファベット3文字
    function validAlliance(v) { return v is string && v.matches('^([A-Z]{3})?$'); }

    // 登録者による「登録」（招待済み → 登録済み）の条件（設計書 9.5）
    function isRegistration() {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == '招待済み'
        && request.time < before.expiresAt
        && after.status == '登録済み'
        && after.diff(before).affectedKeys()
             .hasOnly(['name', 'gameId', 'countryNo', 'alliance', 'status', 'registeredAt', 'updatedAt'])
        && validName(after.name)
        && validGameId(after.gameId)
        && validCountry(after.countryNo)
        && validAlliance(after.alliance)
        && after.registeredAt == request.time
        && after.updatedAt == request.time;
    }

    // 招待。文書IDが招待URLのトークン
    match /invites/{token} {
      // トークンを知っている人は、その1件だけ読める。一覧は管理者だけ
      allow get: if true;
      allow list: if isAdmin();
      // 作成・削除は管理者だけ
      allow create, delete: if isAdmin();
      // 更新は、管理者、または上の条件を満たす「登録」だけ
      allow update: if isAdmin() || isRegistration();
    }

    // ブラックリスト。文書IDがゲームのID（9桁）。読み書きは管理者全員（登録者には見せない）
    function validBlacklistEntry(d) {
      return d.keys().hasOnly(['name', 'reason', 'createdAt', 'addedBy'])
        && d.name is string && d.name.size() <= 40
        && d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 100
        && d.addedBy == request.auth.uid;
    }
    match /blacklist/{gameId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validGameId(gameId)
        && validBlacklistEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // 管理者用メモ（送付先メモ・管理者メモ）
    match /invite_notes/{token} {
      allow read, write: if isAdmin();
    }

    // 枠などの設定。見るのは管理者全員、変更はオーナーだけ
    match /settings/{name} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // 管理者の名簿。本人は自分の文書を読める。一覧・追加・削除はオーナーだけ
    // 追加できるのは移民管理者（manager）だけで、オーナーを増やすことはコンソールからの手作業
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.role == 'manager'
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.createdAt == request.time;
      // 解任。オーナー自身の文書は消せない
      allow delete: if isOwner() && request.auth.uid != uid;
      allow update: if false;
    }

    // 移民管理者になりたい人の申請。本人が自分の分を出せて、オーナーが一覧・承認・却下する
    match /admin_requests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow update: if false;
    }
  }
}
